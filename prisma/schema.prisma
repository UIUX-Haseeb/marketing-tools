// Marketing Tools — data model
// Teams are assigned by an admin (see /admin/users). A user's team decides which tools they see.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Team {
  AGENTS
  HR
  LND
  MARKETING
  OTHER
}

enum Role {
  MEMBER
  ADMIN
}

enum RequestStatus {
  NEW
  IN_PROGRESS
  DONE
  REJECTED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  image     String?
  team      Team     @default(OTHER)
  role      Role     @default(MEMBER)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requests Request[] @relation("RequestedBy")
  assigned Request[] @relation("AssignedTo")
  posts    GeneratedPost[]
}

/// A request sent to the Marketing team. `type` is free-form so each tool can
/// submit its own kind (e.g. "custom-material", "video", "campaign-ad", "hr-custom").
/// `payload` holds tool-specific fields as JSON.
model Request {
  id          String        @id @default(cuid())
  type        String
  title       String
  description String?
  payload     Json?
  status      RequestStatus @default(NEW)
  dueDate     DateTime?

  requesterId String
  requester   User   @relation("RequestedBy", fields: [requesterId], references: [id])
  assigneeId  String?
  assignee    User?  @relation("AssignedTo", fields: [assigneeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([requesterId])
}

/// One row per post a user generated with a post tool (no image stored).
model GeneratedPost {
  id         String   @id @default(cuid())
  tool       String   // registry slug, e.g. "birthday", "baby"
  templateId String   // e.g. "provident-birthday-post"
  subject    String   // employee name as printed on the post
  /// "portal" when the data came from the CRM, "manual" when typed in
  source     String   @default("manual")
  employeeId String?  // Portal employee id, when known
  format     String?  // png | jpg
  bytes      Int?

  userId String
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([tool, createdAt])
  @@index([userId])
}
